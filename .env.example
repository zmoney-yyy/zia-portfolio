# Copy to .env for local dev. Real values live ONLY in Vercel environment variables.
# Nothing here is prefixed PUBLIC_, so none of it reaches the browser.

# Chat (/api/chat)
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-haiku-5-5)
CLAUDE_MODEL=
# Optional: extra instructions appended to the chat system prompt at request time.
# Keep the real text only in Vercel; it is never committed.
CHAT_PRIVATE_RULES=
# Optional: max chat requests per day across all visitors (default 300)
CHAT_DAILY_LIMIT=

# Contact form (/api/contact), sent through Resend
RESEND_API_KEY=
# Optional: verified sender, e.g. "Portfolio <contact@yourdomain>". Defaults to Resend's test sender.
RESEND_FROM=
# Where messages are delivered. Server-side only, never rendered into HTML.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (human check on the contact form).
# The site key is public (it ships in the page) and must be set BEFORE the build, because it is
# inlined at build time. The secret key is server-only. Create both in the Cloudflare dashboard.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis via the Vercel Marketplace sets one of these pairs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
