---
import { hero } from '../data/site';
import Squiggle from './Squiggle.astro';
---

<div class="mx-auto flex max-w-[1120px] flex-wrap items-center gap-12 px-6 pb-16 pt-[72px]">
  <div class="min-w-0 flex-[1_1_560px]">
    <p class="eyebrow mb-5">{hero.eyebrow}</p>
    <h1
      class="display mb-7 text-[clamp(2.5rem,7vw+0.25rem,4rem)] leading-[1.04] tracking-[-0.02em]"
    >
      {hero.headlineBefore}<span class="relative inline-block"
        >{hero.headlineEmphasis}<Squiggle class="absolute -bottom-2.5 left-0 h-3.5 w-full" /></span
      >.
    </h1>
    <p class="mb-9 max-w-[560px] text-xl text-ink-2">{hero.subhead}</p>
    <div class="flex flex-wrap items-center gap-3.5">
      <a href="#work" class="btn btn-solid !text-cream">See my work</a>
      <a href="#ask" class="btn btn-outline">Ask my portfolio</a>
    </div>
  </div>
  <div class="relative h-80 min-w-[240px] flex-[0_1_300px]" aria-hidden="false">
    <svg viewBox="0 0 200 200" aria-hidden="true" class="absolute left-5 top-0 h-[260px] w-[260px]">
      <g stroke="var(--color-accent)" stroke-width="10" stroke-linecap="round">
        <line x1="100" y1="20" x2="100" y2="180"></line>
        <line x1="30" y1="60" x2="170" y2="140"></line>
        <line x1="30" y1="140" x2="170" y2="60"></line>
      </g>
    </svg>
    <p
      class="absolute bottom-0 right-0 m-0 box-border flex h-[148px] w-[148px] rotate-[8deg] items-center justify-center rounded-full bg-sun p-5 text-center text-base font-bold leading-tight text-ink"
    >
      {hero.badge}
    </p>
  </div>
</div>
