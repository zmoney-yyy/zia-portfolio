---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#ask', label: 'Ask my portfolio' },
];
---

<header class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-3 px-6 py-5">
  <a href="/" class="display py-2.5 text-2xl !text-ink no-underline">Zia Hasheem</a>
  <nav aria-label="Primary" class="flex flex-wrap items-center gap-1">
    {
      links.map((l) => (
        <a href={l.href} class="px-3 py-3 text-base font-medium !text-ink no-underline hover:underline">
          {l.label}
        </a>
      ))
    }
    <button
      type="button"
      data-open-contact
      class="cursor-pointer px-3 py-3 text-base font-medium text-ink hover:underline"
      style="font-family: inherit; background: none; border: 0">Contact</button
    >
  </nav>
</header>
